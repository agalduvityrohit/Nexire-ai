# Copy to .env.local and fill in. Never commit .env.local.

# ---------------------------------------------------------------- required
# Encrypts credentials before they are written to the database (AES-256-GCM).
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing this key makes every stored credential unrecoverable.
APP_ENCRYPTION_KEY=

# ---------------------------------------------------------------- storage
# Without these, credentials are held in server memory and lost on restart.
# The service-role key bypasses RLS — server-side only, never expose it.
# Run supabase/migrations/0002_provider_keys.sql after creating the project.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------- LLM choice
# Which provider parses résumés when a company hasn't picked one in Settings.
# One of: gemini | openai | anthropic | groq | cerebras | mistral | openrouter | nvidia
DEFAULT_LLM_PROVIDER=gemini

# ----------------------------------------------------- single-tenant keys
# Optional fallbacks, used when a company has no key of its own stored.
# Each provider also accepts <PROVIDER>_MODEL to override the default model id.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
# NVIDIA NIM — get a key from build.nvidia.com (any model page, free tier available)
NVIDIA_API_KEY=

# e.g. GEMINI_MODEL=gemini-2.5-flash
#      ANTHROPIC_MODEL=claude-sonnet-4-5

# ------------------------------------------------------------------ other
# GitHub is NOT a platform key any more: each company connects its own token in its
# own Settings → Connections, so there is no GITHUB_TOKEN here.

# Gmail résumé ingestion over IMAP. The app password is a 16-character code
# from myaccount.google.com/apppasswords (requires 2-Step Verification).
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# ----------------------------------------------------- founder visitor console
# Who may open /admin (the Visitor Console, company list, API keys). Comma-separated
# emails. The account must ALSO have role "admin" in the database. If this is empty,
# nobody can open /admin.
ADMIN_EMAILS=

# Secret mixed into visitor IP hashes (SHA-256 of ip + this + the date). Without it we
# store NO hash at all, so page views can't be counted. Generate with:
#   openssl rand -hex 32
IP_HASH_SALT=

# Events older than this are deleted daily by /api/cron/purge-events. Default 90.
EVENT_RETENTION_DAYS=90

# Vercel Cron sends this as `Authorization: Bearer <value>` to the purge endpoint, which
# otherwise answers 404. Generate with: openssl rand -hex 32
CRON_SECRET=

# Local `next dev` doesn't write events (it shares the production database). Set to 1
# only when you deliberately want to test event logging locally.
# TRACK_IN_DEV=1
